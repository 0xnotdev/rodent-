{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.proof.dev/v0/error-envelope.schema.json",
  "title": "Proof CLI error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "code",
    "message",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": "https://schemas.proof.dev/v0/error-envelope.schema.json"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    }
  }
}
