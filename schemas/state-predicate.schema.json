{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proof://schema/state-predicate/1.0",
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": {},
          "type": "object"
        }
      ]
    },
    "PredicateOperator": {
      "enum": [
        "EQ",
        "NE",
        "IN",
        "NOT_IN",
        "LTE",
        "GTE",
        "MATCHES",
        "EXISTS",
        "REACHABLE",
        "HEALTHY"
      ],
      "title": "PredicateOperator",
      "type": "string"
    },
    "RelationshipType": {
      "enum": [
        "NETWORK_DEPENDENCY",
        "IDENTITY_DEPENDENCY",
        "STORAGE_DEPENDENCY",
        "ROUTING_DEPENDENCY",
        "SECRET_DEPENDENCY",
        "DEPLOYMENT_DEPENDENCY",
        "CONFIGURATION_DEPENDENCY",
        "TRIGGER_DEPENDENCY",
        "OBSERVABILITY_DEPENDENCY",
        "ATTACHMENT",
        "CONTAINS"
      ],
      "title": "RelationshipType",
      "type": "string"
    },
    "ResourceId": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "ScopeSelector": {
      "additionalProperties": false,
      "properties": {
        "canonical_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceId"
          },
          "title": "Canonical Ids",
          "type": "array"
        },
        "terraform_addresses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Terraform Addresses",
          "type": "array"
        },
        "canonical_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Canonical Types",
          "type": "array"
        },
        "tag_equals": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tag Equals",
          "type": "object"
        },
        "relationship_closure": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RelationshipType"
          },
          "title": "Relationship Closure",
          "type": "array"
        },
        "max_depth": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Max Depth",
          "type": "integer"
        }
      },
      "title": "ScopeSelector",
      "type": "object"
    },
    "StabilizationPolicy": {
      "additionalProperties": false,
      "properties": {
        "deadline_ms": {
          "default": 120000,
          "maximum": 1800000,
          "minimum": 1000,
          "title": "Deadline Ms",
          "type": "integer"
        },
        "initial_delay_ms": {
          "default": 500,
          "maximum": 60000,
          "minimum": 0,
          "title": "Initial Delay Ms",
          "type": "integer"
        },
        "backoff_multiplier": {
          "default": 1.7,
          "maximum": 4.0,
          "minimum": 1.0,
          "title": "Backoff Multiplier",
          "type": "number"
        },
        "max_delay_ms": {
          "default": 10000,
          "maximum": 120000,
          "minimum": 100,
          "title": "Max Delay Ms",
          "type": "integer"
        },
        "consecutive_equal_snapshots": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Consecutive Equal Snapshots",
          "type": "integer"
        },
        "jitter_fraction": {
          "default": 0.1,
          "maximum": 0.5,
          "minimum": 0.0,
          "title": "Jitter Fraction",
          "type": "number"
        }
      },
      "title": "StabilizationPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "predicate_id": {
      "title": "Predicate Id",
      "type": "string"
    },
    "selector": {
      "$ref": "#/$defs/ScopeSelector"
    },
    "property_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Property Path"
    },
    "operator": {
      "$ref": "#/$defs/PredicateOperator"
    },
    "expected": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "oracle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Oracle Id"
    },
    "stabilization": {
      "$ref": "#/$defs/StabilizationPolicy"
    }
  },
  "required": [
    "predicate_id",
    "selector",
    "operator",
    "stabilization"
  ],
  "title": "StatePredicate",
  "type": "object"
}
