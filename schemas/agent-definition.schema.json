{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proof://schema/agent-definition/1.0",
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "additionalProperties": {},
          "type": "object"
        }
      ]
    },
    "Sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "executor": {
      "enum": [
        "SHELL",
        "HARBOR"
      ],
      "title": "Executor",
      "type": "string"
    },
    "image_digest": {
      "title": "Image Digest",
      "type": "string"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "working_directory": {
      "default": "/workspace",
      "title": "Working Directory",
      "type": "string"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "model_parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Model Parameters",
      "type": "object"
    },
    "tool_manifest_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mcp_manifest_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timeout_ms": {
      "default": 900000,
      "minimum": 1000,
      "title": "Timeout Ms",
      "type": "integer"
    }
  },
  "required": [
    "agent_id",
    "executor",
    "image_digest",
    "command"
  ],
  "title": "AgentDefinition",
  "type": "object"
}
