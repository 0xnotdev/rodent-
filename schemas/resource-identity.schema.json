{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proof://schema/resource-identity/1.0",
  "$defs": {
    "ResourceId": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canonical_id": {
      "$ref": "#/$defs/ResourceId"
    },
    "terraform_address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terraform Address"
    },
    "provider_address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Address"
    },
    "arn": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arn"
    },
    "account_id": {
      "anyOf": [
        {
          "pattern": "^[0-9]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Id"
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region"
    },
    "native_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Id"
    }
  },
  "required": [
    "canonical_id"
  ],
  "title": "ResourceIdentity",
  "type": "object"
}
